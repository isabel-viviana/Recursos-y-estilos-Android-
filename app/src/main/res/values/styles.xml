<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ejercicio 03 Styles -->
    <style name="EstiloBotonNormal">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">@color/btn_normal</item>
    </style>

    <style name="EstiloBotonPressed">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">@color/btn_pressed</item>
    </style>

    <style name="EstiloBotonDisabled">
        <item name="android:textColor">#757575</item>
        <item name="android:backgroundTint">@color/btn_disabled</item>
    </style>

    <!-- Ejercicio 08 Card Style -->
    <style name="CardTileStyle">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <!-- Ejercicio 17 Styles -->
    <style name="EstiloBotonContained" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">#00875A</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="EstiloBotonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">#00875A</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">#00875A</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="EstiloBotonText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#00875A</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
