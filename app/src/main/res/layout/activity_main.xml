                android:text="@string/btn_ejercicio_11" />

            <Button
                android:id="@+id/btnEj12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/btn_ejercicio_12" />

            <Button
                android:id="@+id/btnEj13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/btn_ejercicio_13" />

            <Button
                android:id="@+id/btnEj14"
