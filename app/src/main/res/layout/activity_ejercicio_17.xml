<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Green Header Bar -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#00875A"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Theming material design buttons" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center_horizontal">

        <!-- Contained Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContained"
            style="@style/EstiloBotonContained"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ej17_contained"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="30dp" />

        <!-- Outlined Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOutlined"
            style="@style/EstiloBotonOutlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ej17_outlined"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="30dp" />

        <!-- Text Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnText"
            style="@style/EstiloBotonText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ej17_text_btn"
            android:layout_marginBottom="60dp" />

        <Button
            android:id="@+id/btnBackMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_back_to_menu"
            android:backgroundTint="#757575" />

    </LinearLayout>

</LinearLayout>
